<Page
    x:Class="Uno.WebView2.Collapsed.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Uno.WebView2.Collapsed"
    xmlns:us="using:Uno.Simple"
    Background="{ThemeResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="8"
            Orientation="Horizontal"
            Spacing="16">
            <Button Click="OnShowAndNavigateWebViewClick" Content="Show And Navigate" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Bind WebViewCollapsed.Visibility, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="2"
            Margin="8"
            Orientation="Horizontal"
            Spacing="16">
            <Button Click="OnCreateAndNavigateWebViewClick" Content="Create And Navigate" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Bind WebViewPlaceholder.Child, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="4"
            Margin="8"
            Orientation="Horizontal"
            Spacing="16">
            <Button Click="OnOpacityAndNavigateWebViewClick" Content="Change Opacity And Navigate" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Bind WebViewOpacity.Opacity, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            Grid.Row="0"
            Grid.Column="6"
            Margin="8"
            Orientation="Horizontal"
            Spacing="16">
            <Button Click="OnNavigateWebViewVisibleClick" Content="Navigate" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Bind WebViewVisible.Visibility, Mode=OneWay}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Grid.ColumnSpan="7"
            Background="LightBlue" />

        <!--  Note: WebView2.Background is ignored on Linux and macOS  -->
        <WebView2
            x:Name="WebViewCollapsed"
            Grid.Row="1"
            Grid.Column="0"
            Background="LightYellow"
            NavigationCompleted="WebViewCollapsed_NavigationCompleted"
            Visibility="Collapsed" />

        <Border
            x:Name="WebViewPlaceholder"
            Grid.Row="1"
            Grid.Column="2" />


        <!--  Note: WebView2.Background is ignored on Linux and macOS  -->
        <WebView2
            x:Name="WebViewOpacity"
            Grid.Row="1"
            Grid.Column="4"
            Background="LightYellow"
            NavigationCompleted="WebViewOpacity_NavigationCompleted"
            Opacity="0" />

        <!--  Note: WebView2.Background is ignored on Linux and macOS  -->
        <WebView2
            x:Name="WebViewVisible"
            Grid.Row="1"
            Grid.Column="6"
            Background="LightYellow"
            NavigationCompleted="WebViewVisible_NavigationCompleted"
            Visibility="Visible" />

        <TextBlock
            x:Name="WebViewCollapsedStatusTextBlock"
            Grid.Row="2"
            Grid.Column="0"
            Margin="8"
            Foreground="Orange"
            Text="Navigation is not completed" />

        <TextBlock
            x:Name="WebViewCreatedStatusTextBlock"
            Grid.Row="2"
            Grid.Column="2"
            Margin="8"
            Foreground="Orange"
            Text="Navigation is not completed" />

        <TextBlock
            x:Name="WebViewOpacityStatusTextBlock"
            Grid.Row="2"
            Grid.Column="4"
            Margin="8"
            Foreground="Orange"
            Text="Navigation is not completed" />

        <TextBlock
            x:Name="WebViewVisibleStatusTextBlock"
            Grid.Row="2"
            Grid.Column="6"
            Margin="8"
            Foreground="Orange"
            Text="Navigation is not completed" />

        <Border
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="4"
            Background="Black" />

        <Border
            Grid.RowSpan="3"
            Grid.Column="3"
            Width="4"
            Background="Black" />

        <Border
            Grid.RowSpan="3"
            Grid.Column="5"
            Width="4"
            Background="Black" />

    </Grid>

</Page>
