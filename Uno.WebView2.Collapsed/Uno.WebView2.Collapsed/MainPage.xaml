<Page
    x:Class="Uno.WebView2.Collapsed.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Uno.WebView2.Collapsed"
    xmlns:us="using:Uno.Simple"
    Background="{ThemeResource BackgroundBrush}">

    <Page.Resources>
        <local:VisibilityToStringConverter x:Key="VisibilityToStringConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="8"
            Orientation="Horizontal"
            Spacing="16">
            <Button Click="OnShowAndNavigateWebViewCollapsedClick" Content="Show And Navigate" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Bind WebViewCollapsed.Visibility, Mode=OneWay, Converter={StaticResource VisibilityToStringConverter}}" />
        </StackPanel>


        <StackPanel
            Grid.Row="0"
            Grid.Column="2"
            Margin="8"
            Orientation="Horizontal"
            Spacing="16">
            <Button Click="OnNavigateWebViewVisibleClick" Content="Navigate" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{x:Bind WebViewVisible.Visibility, Mode=OneWay, Converter={StaticResource VisibilityToStringConverter}}" />
        </StackPanel>


        <WebView2
            x:Name="WebViewCollapsed"
            Grid.Row="1"
            Grid.Column="0"
            Background="LightYellow"
            NavigationCompleted="WebViewCollapsed_NavigationCompleted"
            Visibility="Collapsed" />

        <WebView2
            x:Name="WebViewVisible"
            Grid.Row="1"
            Grid.Column="2"
            Background="LightYellow"
            NavigationCompleted="WebViewVisible_NavigationCompleted"
            Visibility="Visible" />


        <TextBlock
            x:Name="WebViewCollapsedStatusTextBlock"
            Grid.Row="2"
            Grid.Column="0"
            Margin="8"
            Foreground="Orange"
            Text="Navigation is not completed" />

        <TextBlock
            x:Name="WebViewVisibleStatusTextBlock"
            Grid.Row="2"
            Grid.Column="2"
            Margin="8"
            Foreground="Orange"
            Text="Navigation is not completed" />

        <Border
            Grid.RowSpan="3"
            Grid.Column="1"
            Width="4"
            Background="Black" />

    </Grid>

</Page>
